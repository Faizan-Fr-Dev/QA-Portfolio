        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.token) {",
                  "    pm.globals.set(\"admin_token\", jsonData.token);",
                  "    console.log(\"Saved JWT token to global variables as 'admin_token'\");",
